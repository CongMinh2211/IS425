{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/products", "destination": "/" },
    { "source": "/story", "destination": "/" },
    { "source": "/journal", "destination": "/" },
    { "source": "/contact", "destination": "/" }
  ]
}
